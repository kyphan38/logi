{
  "firestore": [
    {
      "database": "logi-db",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "(default)",
      "rules": "firestore.default.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "logi",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ]
}
