rules_version = '2';

// ============================================================
// logi - Firestore Security Rules
// Single-user personal app: UID allowlist + path ownership.
// Same users/{uid}/... pattern as COGI/MESI.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validCategory(c) {
      // 'sleep' is retired (AMENDMENT-remove-sleep). Rules block new writes.
      return c in ['learn', 'work', 'fitness', 'leisure'];
    }

    function validActivity(d) {
      return d.keys().hasAll(['category', 'startAt', 'status', 'logicalDate', 'logicalWeek'])
        && validCategory(d.category)
        && d.status in ['scheduled', 'active', 'done', 'abandoned']
        && d.startAt is number
        && (d.endAt == null || (d.endAt is number && d.endAt > d.startAt))
        // Block nonsense records at the DB layer, do not trust the client
        && (d.endAt == null || d.endAt - d.startAt <= 15 * 60 * 60 * 1000)
        && d.logicalDate is string
        && d.logicalWeek is string
        // Old records may still have `taskId`. The app no longer writes it,
        // but updates to old records must still pass.
        && (!d.keys().hasAny(['taskId']) || d.taskId == null || d.taskId is string);
    }

    // Routine groups. Items live in the `items` array; rules cannot loop over
    // a list, so only the first item's shape is checked. The whole array is
    // built by one function (`saveItems`).
    function validRoutineItem(i) {
      return i.keys().hasAll(['id', 'text', 'days'])
        && i.id is string
        && i.text is string && i.text.size() <= 80
        && i.days is list && i.days.size() <= 7;
    }

    function validRoutine(d) {
      return d.keys().hasAll(['title', 'order', 'items'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.order is int
        && d.items is list
        && (d.items.size() == 0 || validRoutineItem(d.items[0]))
        && (!d.keys().hasAny(['archivedAt']) || d.archivedAt == null || d.archivedAt is number);
    }

    function validRoutineCheck(d) {
      return d.keys().hasAll(['date', 'checked'])
        && d.date is string && d.date.size() == 10
        && d.checked is map;
    }

    function validEvent(d) {
      return d.keys().hasAll(['title', 'date', 'archivedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        // "2026-10-15". Rules have no date regex, so check length + two dashes.
        && d.date is string && d.date.size() == 10
        && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        // Time is optional. "11:30" - 24h, always 5 characters.
        && (!d.keys().hasAny(['time']) || d.time == null
            || (d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')))
        && (!d.keys().hasAny(['note']) || d.note == null
            || (d.note is string && d.note.size() <= 140))
        && (d.archivedAt == null || d.archivedAt is number)
        && (!d.keys().hasAny(['notified']) || d.notified is map);
    }

    function validDayLog(d) {
      return d.keys().hasAll(['date'])
        && d.date is string
        && (!d.keys().hasAny(['bedtimeAt']) || d.bedtimeAt == null || d.bedtimeAt is number);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /activities/{activityId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validActivity(request.resource.data);
      }

      // weekTargets/{week} - VD "2026-W35"
      match /weekTargets/{week} {
        allow read: if isOwner(uid);
        // A closed week (Sunday 21:00) can no longer be edited
        allow create: if isOwner(uid);
        allow update: if isOwner(uid)
          && (resource.data.lockedAt == null);
        allow delete: if false;
      }

      // taskPool / weekPlans - weekly tasks, removed from the app. Old data
      // stays readable, but nothing writes to it anymore.
      match /taskPool/{taskId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /weekPlans/{week} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // routines/{groupId} - routine templates repeating by weekday.
      // Delete = set archivedAt, like events.
      match /routines/{groupId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRoutine(request.resource.data);
        allow delete: if false;
      }

      // routineChecks/{logicalDate} - e.g. "2026-09-26". Ticks for one day.
      // A new day = a new doc, so "reset" needs no delete.
      match /routineChecks/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRoutineCheck(request.resource.data);
        allow delete: if false;
      }

      // dayLogs/{logicalDate} - e.g. "2026-08-26". The bedtime mark lives here,
      // NOT in activities.
      match /dayLogs/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDayLog(request.resource.data);
        allow delete: if false;
      }

      // events/{eventId} - upcoming events of the Reminder tab.
      // Delete = set archivedAt: the doc must stay so `notified` is not reset,
      // otherwise restoring an item would resend every offset already sent.
      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEvent(request.resource.data);
        allow delete: if isOwner(uid)
          && resource.data.createdAt > request.time.toMillis() - 60 * 1000;
      }

      // meta/debt, meta/settings
      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      // insights/{from_to} - generated AI insights, cached by digestHash
      match /insights/{insightId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
