rules_version = '2';

// ============================================================
// logi - Firestore Security Rules
// App cá nhân một người dùng: allowlist theo UID + ownership theo path.
// Giữ nguyên pattern users/{uid}/... của COGI/MESI.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validCategory(c) {
      // 'sleep' đã ngưng dùng (AMENDMENT-remove-sleep). Rules chặn ghi mới.
      return c in ['learn', 'work', 'fitness', 'leisure'];
    }

    function validActivity(d) {
      return d.keys().hasAll(['category', 'startAt', 'status', 'logicalDate', 'logicalWeek'])
        && validCategory(d.category)
        && d.status in ['scheduled', 'active', 'done', 'abandoned']
        && d.startAt is number
        && (d.endAt == null || (d.endAt is number && d.endAt > d.startAt))
        // Chặn record vô lý ngay ở tầng DB, không tin client
        && (d.endAt == null || d.endAt - d.startAt <= 15 * 60 * 60 * 1000)
        && d.logicalDate is string
        && d.logicalWeek is string
        // Stage 8 (đã gỡ): record cũ còn `taskId`. App không ghi field này
        // nữa, nhưng update record cũ vẫn phải qua được.
        && (!d.keys().hasAny(['taskId']) || d.taskId == null || d.taskId is string);
    }

    // Stage 10 - nhóm routine. Mục nằm trong mảng `items`; rules không lặp
    // được trên list, nên chỉ kiểm hình dạng mục đầu - cả mảng do một hàm
    // duy nhất (`saveItems`) sinh ra.
    function validRoutineItem(i) {
      return i.keys().hasAll(['id', 'text', 'days'])
        && i.id is string
        && i.text is string && i.text.size() <= 80
        && i.days is list && i.days.size() <= 7;
    }

    function validRoutine(d) {
      return d.keys().hasAll(['title', 'order', 'items'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.order is int
        && d.items is list
        && (d.items.size() == 0 || validRoutineItem(d.items[0]))
        && (!d.keys().hasAny(['archivedAt']) || d.archivedAt == null || d.archivedAt is number);
    }

    function validRoutineCheck(d) {
      return d.keys().hasAll(['date', 'checked'])
        && d.date is string && d.date.size() == 10
        && d.checked is map;
    }

    function validEvent(d) {
      return d.keys().hasAll(['title', 'date', 'archivedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        // "2026-10-15". Rules không có regex ngày, nên kiểm độ dài + hai gạch.
        && d.date is string && d.date.size() == 10
        && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        // Giờ là tuỳ chọn. "11:30" - 24 tiếng, luôn 5 ký tự.
        && (!d.keys().hasAny(['time']) || d.time == null
            || (d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')))
        && (!d.keys().hasAny(['note']) || d.note == null
            || (d.note is string && d.note.size() <= 140))
        && (d.archivedAt == null || d.archivedAt is number)
        && (!d.keys().hasAny(['notified']) || d.notified is map);
    }

    function validDayLog(d) {
      return d.keys().hasAll(['date'])
        && d.date is string
        && (!d.keys().hasAny(['bedtimeAt']) || d.bedtimeAt == null || d.bedtimeAt is number);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /activities/{activityId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validActivity(request.resource.data);
      }

      // weekTargets/{week} - VD "2026-W35"
      match /weekTargets/{week} {
        allow read: if isOwner(uid);
        // Tuần đã đóng sổ (21:00 CN) thì không sửa được nữa
        allow create: if isOwner(uid);
        allow update: if isOwner(uid)
          && (resource.data.lockedAt == null);
        allow delete: if false;
      }

      // taskPool / weekPlans - task tuần Stage 8, đã gỡ khỏi app. Dữ liệu cũ
      // giữ nguyên để còn đọc được, nhưng không ai ghi vào nữa.
      match /taskPool/{taskId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /weekPlans/{week} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // routines/{groupId} - Stage 10, template routine lặp lại theo thứ.
      // Xoá = set archivedAt, giống events.
      match /routines/{groupId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRoutine(request.resource.data);
        allow delete: if false;
      }

      // routineChecks/{logicalDate} - VD "2026-09-26". Tick của một ngày.
      // Ngày mới = doc mới, nên "reset" không cần xoá gì.
      match /routineChecks/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRoutineCheck(request.resource.data);
        allow delete: if false;
      }

      // dayLogs/{logicalDate} - VD "2026-08-26". Mốc bedtime sống ở đây,
      // KHÔNG phải trong activities.
      match /dayLogs/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDayLog(request.resource.data);
        allow delete: if false;
      }

      // events/{eventId} - Stage 9, sự kiện sắp tới của tab Reminder.
      // Xoá = set archivedAt: doc phải ở lại để `notified` không bị reset,
      // nếu không thì khôi phục một việc sẽ bắn lại mọi mốc đã gửi.
      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEvent(request.resource.data);
        allow delete: if isOwner(uid)
          && resource.data.createdAt > request.time.toMillis() - 60 * 1000;
      }

      // meta/debt, meta/settings
      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      // insights/{from_to} - nhận xét AI đã sinh, cache theo digestHash
      match /insights/{insightId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Mọi thứ còn lại: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
